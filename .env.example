# Kopiera till .env.local och fyll i lokala/preview-värden.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_SESSION_SECRET=byt-till-en-slumpad-hemlighet-pa-minst-32-tecken

# Stripe (Checkout, hostad betalsida) – hämtas från https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Calendar – OAuth-klient från Google Cloud Console + en engångs
# refresh token för vårdgivarens kalender (se README för hur den skapas).
GOOGLE_CALENDAR_CLIENT_ID=...
GOOGLE_CALENDAR_CLIENT_SECRET=...
GOOGLE_CALENDAR_REFRESH_TOKEN=...
GOOGLE_CALENDAR_ID=primary
# Bas-URL används för att bygga Google OAuth redirect-URI:n vid engångssetupet.
APP_BASE_URL=http://localhost:3000

# Admin → Annonsering. Alla nycklar är serversidiga och valfria tills kontot ansluts.
# Google Ads kräver ett Google Cloud-projekt med Ads API-åtkomst och OAuth-scope
# https://www.googleapis.com/auth/adwords. Utvecklartoken är valfri sedan 2026-09-09.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta Marketing API: åtkomsttoken med ads_read och annonskonto-ID.
# Välj exakt en action_type för konverteringar, t.ex. lead eller purchase.
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
META_ADS_CONVERSION_ACTION=

# TikTok API for Business: auktoriserad app och annonsörskonto.
# Valutan måste motsvara TikTok-kontots faktiska rapportvaluta.
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=
TIKTOK_ADS_CURRENCY=SEK

# Admin → E-post. One.com hämtas skrivskyddat via IMAP; lagra aldrig lösenord i klientkod.
ONECOM_IMAP_HOST=imap.one.com
ONECOM_IMAP_PORT=993
ONECOM_IMAP_USER=
ONECOM_IMAP_PASSWORD=
ONECOM_IMAP_MAILBOX=INBOX
# Slumpad hemlighet som Vercel Cron skickar som Bearer-token.
CRON_SECRET=
